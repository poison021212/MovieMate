PORT=1337
DB_HOST=localhost
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=movie_db
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=1d
JWT_ACCESS_EXPIRE=30m
JWT_REFRESH_EXPIRE=7d
EMAIL_VERIFY_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1
APP_PUBLIC_URL=http://localhost:5173
# 可选：AI 推荐页需要
TMDB_ACCESS_TOKEN=

# LLM（默认本机 Ollama，免费无需 Key）
LLM_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
# 可选：Agent 上下文字符预算（超限时优先保留当前用户消息与最近工具结果）
# LLM_PROMPT_BUDGET_SYSTEM=4000
# LLM_PROMPT_BUDGET_HISTORY=6000
# LLM_PROMPT_BUDGET_TOOL=2000
# LLM_PROMPT_BUDGET_TOTAL=16000

# 云端备选（OpenAI 兼容接口，任选其一填 Key 并改 URL/MODEL）：
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com/chat/completions  LLM_MODEL=deepseek-chat  LLM_API_KEY= 或 DEEPSEEK_API_KEY=
# 千问:     LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions  LLM_MODEL=qwen-turbo  DASHSCOPE_API_KEY=
DASHSCOPE_API_KEY=
