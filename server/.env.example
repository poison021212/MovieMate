# ===== 服务器 =====
PORT=1337

# ===== 数据库 =====
DB_HOST=localhost
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=movie_db

# ===== 认证 / 会话 =====
# 任意足够长的随机字符串，生产必须更换；泄露等于任意账号可伪造
JWT_SECRET=change_me_to_a_long_random_string
# 旧用法兼容（部分脚本引用）
JWT_EXPIRE=1d
# access token 有效期（短，放内存）
JWT_ACCESS_EXPIRE=30m
# refresh token 有效期（长，HttpOnly Cookie）
JWT_REFRESH_EXPIRE=7d
# 邮箱验证链接有效期（小时）
EMAIL_VERIFY_EXPIRE_HOURS=24
# 密码重置链接有效期（小时）
PASSWORD_RESET_EXPIRE_HOURS=1
# 验证/重置链接前缀，默认 http://localhost:5173（本地开发）
APP_PUBLIC_URL=http://localhost:5173

# ===== TMDB（hybrid 搜索 / AI 候选 / 同步脚本）=====
# 需要才填；在 themoviedb.org/settings/api 获取 v4 Read Access Token，严禁提交真实值
TMDB_ACCESS_TOKEN=

# ===== LLM（默认本机 Ollama，免费无需 Key）=====
LLM_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
# 可选：Agent 上下文字符预算（超限时优先保留当前用户消息与最近工具结果）
# LLM_PROMPT_BUDGET_SYSTEM=4000
# LLM_PROMPT_BUDGET_HISTORY=6000
# LLM_PROMPT_BUDGET_TOOL=2000
# LLM_PROMPT_BUDGET_TOTAL=16000

# ===== 云端 LLM 备选（OpenAI 兼容接口，任选其一填 Key 并改 URL/MODEL；严禁提交真实值）=====
# DeepSeek:LLM_BASE_URL=https://api.deepseek.com/chat/completions  LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
# 千问(DashScope):LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions  LLM_MODEL=qwen-turbo
DASHSCOPE_API_KEY=
# Gemini:LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions  LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=